:15
if mon>0 then pln Монстар дабраўся да вас і разарваў на кавалкі. & goto 8f
if pods=1 then goto 16
if not Ключ ад бакоўкі then pln Дзверы не адкрываюцца - яны замкнёныя на ключ. & goto 13
if Ключ ад бакоўкі then pln Вы адчынілі дзверы ў бакоўку. Цяпер гэты ключ вам больш не патрэбен і вы выкінулі яго. & pln ВЫ ВЫКІНУЛІ КЛЮЧ АД БАКОЎКІ. & pods=1 & & inv- Ключ ад бакоўкі & goto 13
end

:16
p У гэтым памяшканні ляжыць куча хламу, але ўсё ж ёсць і патрэбныя рэчы.
if med1=0 then p На паліцы вы бачыце флакончык з надпісам "Спрэй першай дапамогі" & btn 17,Узяць спрэй 
p На століку стаіць старая друкавальная машынка. Як яна магла тут апынуцца?
if ink1=0 then p На тым жа століку ляжыць чарнільная стужка для друкавальнай машынкі. & btn 18,Узяць чарнільную стужку.
btn 19,Уключыць друкавальную машынку

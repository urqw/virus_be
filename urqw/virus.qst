if plant=1 then pln Вы пайшлі насустрач сваёй смерці. & goto 8f
if Карта B then pln Вы адчынілі дзверы і ўвайшлі.
if not Карта B then pln Высвечваецца надпіс " Патрэбна карта Ў ". & goto 30
plant=1
pla=0
pln Вы зайшлі ў батанічны аддзел і ўбачылі наступнае : Са шматлікіх адтулін у столі звісаюць таўсценныя сцябліны, што сілкуюць пачварныя пупышкі. Усярэдзіне пупышак відавочна нешта выспявае. Раптам вашу руку аплёў дубец адной з драпежных раслін. Вы не змаглі вызваліць руку ад яе дубца і таму проста перасеклі яго сваім нажом. Вы намерыліся ўжо ваяваць, але раптам убачылі, што пад столлю проста над вамі звісаюць такія ж вырадкі. Іх усяго штук дзесяць, а ў вас - менш, чым паў-картрыджы гаручага. У вас не было ніякіх шанцаў перамагчы ў гэтай сутычцы і вы хутка пабеглі ў папярэдняе памяшканне. Дзверы тут замкнуць няма як і неўзабаве яны аўтаматычна адчыняцца перад раслінамі. Трэба бегчы!
goto 30
end

:51
if zomb7=0 then pln Вы з Сарай зайшлі ў батанічны аддзел. Расліны-мутанты, якія пераследавалі вас,  так і засталіся на ўваходзе ў сектар B і зараз давядзецца разабрацца з тымі, што паспелі пазней і засталіся каля "маці". & goto f7
pln Вы знайшлі вашых загінулых таварышаў і выявілі пры іх  картку ад аварыйнага ліфта і маленькі ключ. & inv+ Карта ад ліфта & inv+ Маленькі ключ
pln Вы знаходзіцеся ў батанічным аддзеле. Адсюль можна пайсці ў памяшканне са спорамі, назад ў тунэль ці ў дзверы, за якімі лесвіца на другі паверх.

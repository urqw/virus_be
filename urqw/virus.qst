:4
pln Пароль дакладны
pause 1500
cls
pln На маніторы высвеціўся зялёным тэкст: "Доступ на аб'ект дазволены". 

:4.1
pln Вы ўвайшлі ў наступнае памяшканне. Тут адбылося нешта нядобрае і дзіўнае: бачныя сляды страляніны, паўсюль плямы крыві, сцены пашчэрбленыя кулямі, але няма ніводнага мёртвага цела. Некалькі светлавых панэляў ў дальнім канцы памяшкання не гараць і ён ахутаны змрокам. Там праглядваюцца дзверы, за якімі - новая лакацыя. 
pln Некалькімі звыклымі рухамі вы правяраеце бронекамізэльку, папраўляеце на галаве берэт  і правяраеце, як ходзіць у похвах нож. 
if not Армейскі нож then inv+ Армейскі нож
if not Бронекамізэлька then inv+ 100,Бронекамізэлька
if not Ліхтарык then inv+ Ліхтарык
btn 5,Адчыніць дзверы
if light=0 then btn 6,Уключыць ліхтар
if light=1 then btn 7,Абшукаць далёкі кут
end

:7
if Карта C then pln Тут больш нічога няма, акрамя крыві і слядоў куль. & goto 4.1
inv+ Карта C
inv+ План
pln Вы знаходзіце картку з палоскай штрых-кода і план будынка.
goto 4.1
end

:Use_План
imagetype=6
image=54
end

:6
pln Вы запалілі наплечный ліхтар.
light=1
goto 4.1
end

:5
kill=0
if not Карта C then pln Высвечваецца надпіс "Патрэбен пропуск". & goto 4.1
pln Вы праходзіце ў наступнае памяшканне. Тут, абапёршыся плячамі аб сцяну, на падлозе сядзіць нейкі чалавек. Ён совае вам у руку пісталет і са словамі "Вазьмі і забі мяне" памірае.
inv+ Пісталет Глок 17
inv+ 15, Патронаў
pln       ВЫ АТРЫМАЛІ ПІСТАЛЕТ ГЛОК 17 І АБОЙМУ Да ЯГО
pause 4000 
GOTO 8
end

:8
cls
pln Вы праверылі яго пульс - так і ёсць, зараз ён мёртвы.
btn 9,Стрэліць яму ў галаву
btn 10,Агледзецца
end

:9
kill=1
inv- Патронаў
goto 10

:10
if mon=2 then pln Вы пайшлі насустрач сваёй смерці - монстар адным ударам рассек вас напалову. & goto 8f
if plant=1 and zomb4=0 then pln У гэтым памяшканні нейкі чалавек адстрэльваўся ад націску пецярых зомбі. Адзін зомбі дабраўся да яго і ўчапіўся яму ў шыю. Вы хутка падбеглі і ўсадзілі гэтаму зомбі нож проста пад чэрап. Падобна, што вы прыкончылі яго, але ўвага астатніх чацвярых яго прыяцеляў зараз цалкам звернутае на вас. & fight=4 & goto f4
if plant=1 then pln Паранены чалавек ачомаўся, падняўся, агледзеў мёртвых зомбі, што ляжалі на падлозе, затым паглядзеў на вас. На яго твары з'явілася нейкая злая ўсмешка і ён сказаў "Мдаа, не чакаў ад цябе дапамогі, Рэй. Шкада, што давядзецца адплаціць табе кепскім!". Ён дастаў свой пісталет і тры разу стрэліў у цыстэрну з монстрам. Шкло не вытрымала вялікага ціску і разляцелася дашчэнту. На засыпаную аскепкамі падлогу звалілася трохметровая туша. Той гнюс уцёк у сектар А, зачыніўшы за сабой дзверы. А монстар пачаў ачуньваць і павольна паднімацца на ногі. Трэба рабіць ногі! & mon=1 
if kill=0 then pln Раптам мярцвяк ззаду вас устаў і накінуўся на вас. На шчасце, пацярпела толькі бронекамізэлька і вы, адапхнуўшы яго, прыкончылі небараку адным стрэлам у галаву. Калі зомбі зваліўся, з яго кішэні вываліўся нейкі ключ. & key1=1 & inv+ Ключ ад бакоўкі & inv- 20,Бронекамізэлька & inv- Патронаў & kill=1 & pln ВЫ АТРЫМАЛІ КЛЮЧ
if plant=0 then pln Вы ўвайшлі ў наступнае памяшканне. Сцены, як і ўсюды, тут усе ў плямах крыві і слядах ад куль. Таксама тут стаяць тры вялікія шкляныя цыстэрны. З іх не пабітая толькі адна і ў гэтай цыстэрне, у ёй... Монстар, увесь пакрыты луской, з кіпцюрамі даўжынёй 30 сантыметраў... Ён знаходзіцца ў растворы, што падтрымлівае яго ў стане сну. Не хочацца нават думаць пра тых няшчасных, што аказаліся побач, калі дзве астатнія цыстэрны разбіліся. Аднак пры ўсім гэтым няма ніводнага трупа... 
pln Адсюль ёсць дзверы ў сектар A і ў сектар B.
if seca=0 then pln Вы зноў у гэтым памяшканні. & boss=boss+1
btn 11, У сектар A
btn 12, У сектар B
end

:11
if plant=1 then pln Монстар заступіў вам шлях і адным ударам сваёй велізарнай лапішчы з вострымі даўжэзнымі кіпцюрамі перарэзаў вас папалам. & goto 8f
if seca=1 then pln Дзверы замкнёныя. & goto 10
goto 77
end

:12
if secb=0 then pln Дзверы моцна пашкоджаныя кіпцюрамі монстра, але ўсё яшчэ зачыненыя. & goto 10
if mon>0 then mon=mon+1
if mon>2 then pln Монстар дабраўся да вас і разарваў вас на кавалкі. & goto 8f
if plant=1 and secc=1 then pln Расліны-мутанты дабраліся да вас і разарвалі на шматкі. & goto 8f
if plant=1 then pln Над адным  з кампутараў мірганула чырвоненькае вочка дыстанцыйнага сканера штрых-кодаў і на маніторы высвеціўся  надпіс " Да вас дастаўлена пошта " & btn 12.1,Праверыць пошту
p Дзверы перад вамі аўтаматычна адчыніліся і вы ўвайшлі ў сектар B .Тут вісіць густы трупны смурод. Усё памяшканне застаўлена кампутарамі і нейкай тэхнікай, зрэшты большасць іх разбітая падчас шалёнай страляніны. На падлозе валяюцца цэлыя россыпы стрэляных гільз. 
if zomb1=0 then p Быццам бы нікога тут няма, аднак памяшканне далей паварочвае, і аддтуль чытны нейкія гукі.
btn 13,Ісці за паварот
btn 10,Выйсці
end

:12.1
pln Высвяціўся надпіс " Просім выбачэнні за затрымку, з-за праблем на вэб-вузле. Затрымка паведамлення : 2 гадзіны. ".
pln Каму : капітану Рэю Джонсану
pln Ад каго : штаб-кватэра V.A.M.
pln "Капітан, мы атрымалі сігнал SOS з вашага сектара. Мы не можам рызыкаваць людзьмі, каб выслаць да вас падмогу. У сувязі з тым, што вялікая частка лабараторыі захоплена радыяцыйнай расліннасцю і моцна пашкоджана "Раслінай 100", а зачыстка лабараторыі ад зомбі і іншых мутантаў з'яўляецца празмерна рызыкоўнай, мы палічылі  патрэбным задзейнічаць тактычныя ядзерныя ракеты, якія цалкам знішчаць усю лабараторыю роўна праз тры гадзіны. За гэты час вы і ўвесь незараженный персанал павінны пакінуць лабараторыю і выляцець на двух верталётах, што знаходзяцца  на ўзлётнай пляцоўцы."
pln Значыцца засталася ўсяго гадзіна да таго, як усё тут ператворыцца ў пекла.
btn 12,Адысці ад кампутара 
end

:13
if mon>0 and secb=0 then goto 36
if mon>0 then mon=mon+1
if mon>3 then pln Монстар дабраўся да вас і рассек адным ударам сваёй лапішчы. & goto 8f
if mon>0 then pln Монстар вось-вось зойдзе ў сектар У, і тады выратаванні ўжо сапраўды не будзе.
if plant=1 then pla=pla+1
if plant=1 and pla>4 and secc=1 then pln Расліны-мутанты дабраліся да вас і разарвалі на шматкі. & goto 8f
if plant=1 and secc=0 then pln Расліны-мутанты намагаюцца прапаліць кіслатой тытанавыя дзверы, але падобна ім гэта не ўдаецца. 
if zomb1=0 then pln Вы ўбачылі парачку зомбі, што пажыраюць мёртвага чалавека. Падобна, яны заўважылі вас і зараз давядзецца адстрэльвацца. & goto f1
pln У гэтым памяшканні знаходзіцца кампутар, які кіруе ўсімі электроннымі замкамі. Таксама тут ёсць двое дзвярэй - у бакоўку і ў сектар C.
btn 14,Уключыць кампутар
btn 15,Зайсці ў бакоўку
btn 12,Ісці ў другі канец памяшкання
btn 20,Ісці ў сектар C
end

:20
if secc=0 then pln Дзверы закрытыя на электронны замок. & goto 13
if plant=1 then pla=pla+1
if plant=1 and pla>3 then pln Расліны-мутанты дабраліся да вас і разарвалі вас на часткі. & goto 8f
pln Вы зайшлі ў сектар C. Тут нейкая лабараторыя. стаіць шмат шкляных рэзервуараў, але ўсе яны пустыя. Падобна, што хтосьці паспешліва пазабіраў паддоследных стварэнняў адтуль. Што б гэта магло значыць?
if zomb2=0 then pln Раптам нехта схапіў вас за нагу. Вы апусцілі свой позірк і вас ледзь не зблажыла. Мярцвяк, які страціў ногі і частку жывата падцягваецца да вашай нагі ў надзеі перакусіць. Ізноў бітва не на жыццё, а на смерць! & goto f2 
spr=0
p Бачны дзверы ў наступнае памяшканне, а таксама мёртвы службовец персанала ў куце.
if pism=0 then pln На паліцы побач з вамі ляжыць нечы дзённік.
btn 21,Агледзець труп
btn 23,Прагледзець дзённік
btn 24,У наступнае памяшканне
btn 13,У сектар B
end

:24
if plant=1 then pla=pla+1
if pla>2 then pln Расліны-мутанты дабраліся да вас і забілі сваёй кіслатой. & goto 8f
if Агнямёт and mox=0 then btn 24.1,Падпаліць мох агнямётам
if spore=0 then pln Як толькі адчыніліся дзверы, у памяшканні ўзвіхрылася нейкая зялёная смуга. Вы адчулі пякотку па ўсёй скуры і адышліся далей ад дзвярэй. Цяпер вы заўважылі, што ніякая гэта не смуга, а нейкія малюсенькія парушынкі... споры. Мабыць іх выпускае нейкая расліна, над якой папрацавалі генетыкі. У любым выпадку, доўга знаходзіцца ў наступным памяшканні відавочна не варта. & spore=1 & goto 20
if not Спецкостюм then spr=spr+1
if spr>2 then pln Вы ўдыхнулі і споры трапілі ў вашыя лёгкія. Пякотка проста невыносная, яшчэ зусім трошкі і вы застанецеся тут назаўжды. & inv- 10,Здароўя
if mox=0 then p Усё памяшканне абрасло нейкім мохам, які, мабыць і выпускае гэтыя споры.
if zomb3=0 then p На падлозе валяюцца тры трупы, напэўна загінулых з-за ўдушша. 
p Побач з вамі - дзверы, аднак падобна, што на іх кодавы замак. Таксама ёсць, мяркуючы па ўсім незамкнёныя дзверы ў дзесяці метрах ад вас.
if mox=1 then btn 24.2,Адкрыць камеру захоўвання
btn 26,Да кодавых дзвярэй
btn 30,Ісці да незамкнёных дзвярэй
btn 20,Ісці ў сектар C
end

:24.2
if Карта B then pln Усярэдзіне нічога няма & goto 24
pln На маленькім экране высвяціўся надпіс "Запасная карта B. Толькі для персанала. Увядзіце пароль.". Вы ўвялі сваё імя і замак адкрыўся. У скрыні была  карта B.
inv+ Карта B
goto 24
end

:24.1
pln Вы ў некалькіх месцах падпалілі мох са свайго агнямёта. Увесь мох імгненна згарэў і вы ўбачылі ўбудаваную ў сцяну камеру захоўвання.
mox=1
inv- Паліва
goto 24
end

:26
if plant=1 then pln Расліны-мутанты загналі вас у тупік і разарвалі на шматкі. & goto 8f
if kod1=1 then goto 27
spr=spr+1
if spr>2 then pln Вы ўдыхнулі і споры трапілі ў вашыя лёгкія. Пякотка проста невыносная, яшчэ зусім трошкі і вы застанецеся тут назаўжды. & inv- 10,Здароўя
pln "Увядзіце код"
pln #%fa$ #%sa$ #%ta$
; заўвага. пры падрыхтоўцы да перакладу гульні я тэставаў яе на праходнасць. у гэтым месцы, дзе трэба ўвесці код, у мяне ўзнікла праблема. на акурке і вэбурке ў гэтым месцы экран без тэксту, кнопкі знікаюць - лічы, вылет гульні. разабрацца ў памылцы кода не змог. таму кнопкі ўводу пароля на дзверы заблакаваў, дапісаўшы перад імі па адзінцы і дадаў два ўмоўных пераходу goto, якія знаходзяцца на двух радках ніжэй. такім чынам персанаж проста па памяці набірае патрэбны пароль - ці не набірае - ніяк не задзейнічаючы гульца. 
if дзённік=1 then btn 27, Вы па памяці ўвялі код, які бачылі ў дзённіку
if дзённік=0 then btn 24, Ніякага кода вы не ведаеце і вам даводзіцца адступіць

1btn 26.1,1
1btn 26.2,2
1btn 26.3,3
1btn 26.4,Ok
end

:26.1

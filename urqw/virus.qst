inv+ Спецкостюм
goto 27
end

:29
pln Вы ўзялі спрэй першай дапамогі.
inv+ F.A.S.
med2=1
goto 27
end

:30
if plant=1 then pla=pla+1
if pla>1 then pln Пакуль вы марудзілі, расліны дабраліся да вас і разарвалі на шматкі & goto 8f
if zomb3=0 then pln Чорт! Трупы, што ляжалі на падлозе аказаліся зомбі! Мабыць гэтыя праклятыя споры таксама заражоныя вірусам. Уся скура ў гэтых зомбі стала светла-зялёнай, а на шыі ўтварыўся велізарны празрысты мяшок з нейкай вадкасцю ўсярэдзіне. Адзін з зомбі зрабіў глытальны рух шыяй і выплюнуў усю жыжку з подшейного мяшка цаляючы ў вас. Добра, што ён быў дастаткова далёка і жыжка трапіла толькі на падлогу. Жыжка пачала раз'ядаць сталёвую падлогу лабараторыі! Давядзецца ваяваць з гэтымі вырадкамі! & goto f3
spr=0
pln Вы ўвайшлі ў наступнае памяшканне. Хаця б тут няма ніякіх мерцвякоў. А не, ёсць адзін. Проста перад вамі на крэсле перад уключаным кампутарам сядзіць нейкі чалавек у спецкостюме з прастрэленай патыліцай. Падобна хтосьці забіў яго, калі ён працаваў на кампутары. Значыцца тут ёсць жывыя людзі, якіх трэба асцерагацца. Ёсць два выйсці - у памяшканне са спорамі і ў батанічны аддзел.

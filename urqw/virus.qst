:1f
if not Здароўя then goto 8f
if sara=1 then proc 13f
if jizn<1 then goto 6f
if fight=10 then pln Трохметровы мутант даволі хутка набліжаецца да вас.
if fight=8 and jizn>90 then pln Да вас ідуць чацвёра галодных зомбі.
if fight=8 and jizn>60 and jizn<91 then pln Да вас павольна ідуць трое зомбі.
if fight=8 and jizn>30 and jizn<61 then pln Два мерцвякі прагнуць вашай крыві і ідуць да вас.
if fight=8 and jizn<31 then pln Адзін зомбі набліжаецца да вас, шорхаючы нагамі.
if fight=7 and jizn>90 then pln Да вас павольна спаўзаюцца чатыры расліны.
if fight=7 and jizn<91 and jizn>60 then pln Тры расліны павольна паўзуць да вас, варушачы сваімі дубцамі.
if fight=7 and jizn<61 and jizn>30 then pln Да вас паўзуць дзве расліны
if fight=7 and jizn<31 then pln Да вас паўзе апошняя расліна-мутант.
if fight=6 and jizn>100 then pln Да вас ідуць трое зомбі, невыносна стогнучы пры гэтым.
if fight=9 and jizn>70 and jizn<91 then pln Да вас ідуць трое зомбі.
if fight=9 and jizn>90 then pln Чацвёра зомбі павольна ідуць да вас.
if fight=6 and jizn>49 and jizn<101 then pln Да вас цягнуцца рукі дваіх зомбі.
if fight=6 and jizn<50 then pln Адзін мярцвяк цягнецца да вас не звяртаючы ні на што ўвагі.
if fight=5 then pln У ваш бок рухаецца цэлая гурма жывой мярцвячыны. Напэўна у ізалятары знаходзілася недзе з паўсотні зомбі.
if fight=5 and inv_Здароўя<30 then pln Раптам дзверы, на якія вы абаперліся спінай рэзка адчыніліся. Не чакаўшы такога, вы паваліліся на падлогу, проста пад ногі зомбі. Мярцвячыя рукі ўжо пацягнуліся да вас, але тут да вас падскочыў чалавек у спец-касцюме, з тварам, прыкрытым ахоўным шчытком, і адкрыў па зомбі агонь са свайго M-16. Вы паспешліва ўсталі на ногі і рынуліся ў адчыненыя дзверы. Ваш нечаканы выратавальнік перастаў абстрэльваць зомбі  і бяжыць за вамі. & goto 49
if fight=3 & not Спецкостюм then spr=spr+1
if fight=3 and spr>2 then pln Вы ўдыхнулі і пякучыя споры імгненна трапілі ў вашы лёгкія. Яшчэ трохі і вы памрэце ад удушша. & inv- 10,Здароўя
if fight=1 or fight=9 and jizn>35 and jizn<71 then pln Перад вамі два зомбі. Яны галодныя і павольна ідуць да вас.
if fight=1 or fight=9 and jizn<36 then pln Да вас набліжаецца галодны зомбі.
if fight=4 and jizn<31 then pln Перад вамі зомбі. Ён павольна ідзе да вас.
if fight=4 and jizn>60 and jizn<96 then pln Да вас набліжаюцца трое зомбі.
if fight=4 and jizn>30 and jizn<61 then pln Перад вамі двое зомбі. Яны галодныя і павольна ідуць да вас.
if fight=4 and jizn>95 then pln Перад вамі чацвёра зомбі. Яны галодныя і павольна ідуць да вас.
if fight=3 and jizn>34 and jizn<68 then pln Двое мутаваных зомбі ідуць да вас.
if fight=3 and jizn<35 then pln Да вас набліжаецца мутаваны зомбі. Гарлавы мяшок на ягонай шыі становіцца шырэйшым, ён ізноў назапашвае кіслату.
if fight=2 then pln Зомбі прагна цягнецца да вашай нагі.
if fight=1 and jizn<36 then pln Адзін зомбі павольна ідзе да вас
mest2=mest2-1
if fight=10 then mest2=mest2-1
if fight=7 and not Бронекамізэлька then pln Расліна - мутант плюнула ў вас кіслатой і пакінула на вашым целе крывацечныя раны. & inv- 10,Здароўя
if fight=7 and mest2=1 and Бронекамізэлька then pln Расліна - мутант плюнула ў вас кіслатой. Тая пачала раз'ядаць вашу бронекамізэльку. & inv- 10,Бронекамізэлька
if mest2<0 then mest2=1
if mest=0 then pln Вы ўперліся спінай у сцяну. Дарогі да адступлення больш няма!
if mest2=1 then pln Вораг ужо зусім блізка!
if fight=3 and mest2=1 then a=rnd*2
if fight=3 and a<1 and a>0 then pln Зомбі плюнуў у вас кіслатой, але прамахнуўся. & a=0
if fight=3 and a>1 and not Бронекамізэлька then pln Зомбі плюнуў у вас кіслатой, якая пакінула на вашым целе крывацечныя раны. & inv- 10,Здароўя & a=0
if fight=3 and a>1 and Бронекамізэлька then pln Зомбі плюнуў у вас кіслатой, аднак вас выратавала бронекамізэлька. У некаторых месцах кіслата прапаліла браню наскрозь. & inv- 10,Бронекамізэлька & a=0
if not Патронаў and not Шроту and not Паліва then pln Здаецца, у вас скончыліся боепрыпасы. Давядзецца адбівацца нажом.
if fight<10 and mest2=0 and Бронекамізэлька then inv- 20,Бронекамізэлька & pln Гэтае стварэнне дабралася да вас і зараз спрабуе разарваць вашу бронекамізэльку на шматкі! 
if fight<10 and mest2=0 and not Бронекамізэлька then pln Гэтае стварэнне дабралася да вас і пачало з рыканнем ўгрызацца ў вашае сакавітае цела. Чорт, як балюча! & inv- 15,Здароўя 
if fight=10 and mest2=0 then pln Мутант здзейсніў магутны ўдар. Страшэнныя кіпцюры секанулі вашу плоць. & inv- 20,Здароўя
if Патронаў да аўтамата then btn 14f,Секануць ворага аўтаматнай чаргой
if mest2<4 and Паліва then btn 12f,Падпаліць ворага з агнямёта
if Шроту then btn 11f,Страляць з драбавіка
if Патронаў then btn 3f,Страляць у ворага
if Патронаў then btn 9f,Страляць ворагу ў галаву
if not Патронаў and not Шроту and not Паліва then btn 10f,парнуць ворага нажом
btn 5f,Адапхнуць ворага  
if mest>1 then btn 7f,Адысці назад
btn 1f,Чакаць
end

:14f
pln Вы абстралялі ворага з аўтамата.
inv- 5,Патронаў да аўтамата
jizn=jizn-35
goto 1f
end

:13f
